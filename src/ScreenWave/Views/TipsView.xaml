<UserControl x:Class="ScreenWave.Views.TipsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="24,18,24,8">
      <TextBlock Text="Speed-up settings" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource PageSub}"
                 Text="Samsung's own background services can't be removed, but these settings switch most of them off. Do each one on the TV with the remote and tick it here. Menu names vary a little by year."/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4">
      <ItemsControl x:Name="TipList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,12">
              <DockPanel>
                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,3,12,0"
                          IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                <StackPanel>
                  <TextBlock Text="{Binding Tip.Title}" FontWeight="SemiBold" FontSize="14"/>
                  <TextBlock Text="{Binding Tip.Why}" Foreground="{StaticResource Grey}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  <TextBlock Text="{Binding Tip.Where}" Foreground="{StaticResource Blue}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Clear ticks" Style="{StaticResource GhostButton}" Click="OnClear"/>
        <TextBlock x:Name="ProgressText" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
