<UserControl x:Class="ScreenWave.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Field" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Width" Value="300"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,4,0,10"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,18,24,18" MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource PageSub}"
                 Text="Connect your own ad blocker so 4. Stop apps coming back can add the block list for you. These are only ever local addresses on your network, and are saved on this PC only."/>

      <!-- AdGuard Home -->
      <TextBlock Text="ADGUARD HOME" Foreground="{StaticResource Grey}" FontSize="11" FontWeight="SemiBold" Margin="0,22,0,8"/>
      <Border Style="{StaticResource Card}" Padding="20,16">
        <StackPanel>
          <TextBlock Text="Address (the one you open AdGuard Home on, e.g. 192.168.0.10 or 192.168.0.10:3000)"/>
          <Border Style="{StaticResource Field}">
            <TextBox x:Name="AgAddress" BorderThickness="0" Height="32" VerticalContentAlignment="Center"/>
          </Border>
          <TextBlock Text="Username"/>
          <Border Style="{StaticResource Field}">
            <TextBox x:Name="AgUser" BorderThickness="0" Height="32" VerticalContentAlignment="Center"/>
          </Border>
          <TextBlock Text="Password"/>
          <Border Style="{StaticResource Field}">
            <PasswordBox x:Name="AgPassword" BorderThickness="0" Height="32" VerticalContentAlignment="Center"/>
          </Border>
          <CheckBox x:Name="AgRemember" Content="Remember the password on this PC (encrypted for your Windows account)"/>
          <StackPanel Orientation="Horizontal" Margin="-8,12,0,0">
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSaveAdGuard"/>
            <Button Content="Open AdGuard Home" Style="{StaticResource GhostButton}" Click="OnOpenAdGuard"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Pi-hole -->
      <TextBlock Text="PI-HOLE" Foreground="{StaticResource Grey}" FontSize="11" FontWeight="SemiBold" Margin="0,22,0,8"/>
      <Border Style="{StaticResource Card}" Padding="20,16">
        <StackPanel>
          <TextBlock Text="Address (e.g. 192.168.0.11, or 192.168.0.11:8080 if it runs in Docker on another port)"/>
          <Border Style="{StaticResource Field}">
            <TextBox x:Name="PhAddress" BorderThickness="0" Height="32" VerticalContentAlignment="Center"/>
          </Border>
          <TextBlock Text="Password (Pi-hole v6) or API token (Pi-hole v5: Settings › API › Show API token)" TextWrapping="Wrap"/>
          <Border Style="{StaticResource Field}">
            <PasswordBox x:Name="PhPassword" BorderThickness="0" Height="32" VerticalContentAlignment="Center"/>
          </Border>
          <CheckBox x:Name="PhRemember" Content="Remember it on this PC (encrypted for your Windows account)"/>
          <StackPanel Orientation="Horizontal" Margin="-8,12,0,0">
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSavePiHole"/>
            <Button Content="Open Pi-hole" Style="{StaticResource GhostButton}" Click="OnOpenPiHole"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock x:Name="StatusText" Margin="0,14,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
