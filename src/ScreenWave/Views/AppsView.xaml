<UserControl x:Class="ScreenWave.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="24,18,24,8">
      <TextBlock Text="Remove apps" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource PageSub}"
                 Text="Apps the TV allows to be removed can be ticked. Opened shows how often each has been used on this TV. Samsung's own system apps are left alone – removing those can break the home screen. Removed apps can be reinstalled from the TV's Apps store."/>
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="24,4,24,8">
      <CheckBox x:Name="ShowCore" DockPanel.Dock="Right" Content="Show Samsung system apps" VerticalAlignment="Center"
                Foreground="{StaticResource Grey}" Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
      <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource Grey}"/>
    </DockPanel>

    <Grid Grid.Row="2" Margin="24,0,24,6">
      <DataGrid x:Name="AppGrid">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="44">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                          IsEnabled="{Binding CanRemove}" HorizontalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="App" Width="2*" SortMemberPath="Title">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Id}" Foreground="{StaticResource Grey}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Opened" Binding="{Binding UsedText, Mode=OneWay}" Width="100" IsReadOnly="True" SortMemberPath="UseSort"/>
          <DataGridTextColumn Header="Type" Binding="{Binding KindText, Mode=OneWay}" Width="1.2*" IsReadOnly="True"/>
          <DataGridTextColumn Header="Suggested" Binding="{Binding SuggestedText, Mode=OneWay}" Width="110" IsReadOnly="True"/>
          <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="1.2*" IsReadOnly="True"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                 Foreground="{StaticResource Grey}" FontSize="15" TextWrapping="Wrap" MaxWidth="480"
                 Text="Connect to the TV first (1. Connect to the TV)."/>
    </Grid>

    <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="RefreshButton" Content="Refresh list" Style="{StaticResource GhostButton}" Click="OnRefresh"/>
          <Button x:Name="SuggestButton" Content="Tick suggested" Style="{StaticResource GhostButton}" Click="OnSuggest"/>
          <Button x:Name="RemoveButton" Content="Remove selected" Style="{StaticResource DangerButton}" Click="OnRemove" IsEnabled="False"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock x:Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis"/>
          <ProgressBar x:Name="BusyBar" Style="{StaticResource BusyBarStyle}" Margin="0,8,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
