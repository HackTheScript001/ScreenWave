<UserControl x:Class="ScreenWave.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,18,24,18" MaxWidth="860" HorizontalAlignment="Left">
        <TextBlock Text="Connect to the TV" Style="{StaticResource PageTitle}"/>
        <TextBlock Style="{StaticResource PageSub}"
                   Text="ScreenWave talks to the TV through Samsung's Developer Mode, over your local network or a cable straight from this PC. The TV doesn't need the internet, and nothing is sent anywhere."/>

        <!-- Step A: Developer Mode -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,16">
          <StackPanel>
            <TextBlock Text="A.  Let this PC talk to the TV (one-off, on the TV)" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Foreground="{StaticResource Grey}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Samsung TVs have a hidden setting called Developer Mode. Turning it on and giving it this PC's number lets ScreenWave connect. Do these on the TV with its remote:"/>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Width="24" Height="24" CornerRadius="12" Background="{StaticResource Blue}" VerticalAlignment="Top">
                <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,2,0,14">
                <TextBlock Text="Open the Apps screen" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grey}"
                           Text="Press Home on the remote, then pick Apps from the bar along the bottom. You should see the list of apps you can download."/>
              </StackPanel>

              <Border Grid.Row="1" Width="24" Height="24" CornerRadius="12" Background="{StaticResource Blue}" VerticalAlignment="Top">
                <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,2,0,14">
                <TextBlock Text="Type 1 2 3 4 5 while you're on the Apps screen" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grey}"
                           Text="Nothing shows while you type – that's normal. A box called Developer Mode pops up after the 5. If your remote has no number buttons, press its 123 button to bring up numbers on screen, or use the remote in the SmartThings phone app."/>
              </StackPanel>

              <Border Grid.Row="2" Width="24" Height="24" CornerRadius="12" Background="{StaticResource Blue}" VerticalAlignment="Top">
                <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,2,0,14">
                <TextBlock Text="In that box, switch Developer Mode to On" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grey}"
                           Text="Then select the box underneath it (it's called Host PC IP) and type in this number:"/>
                <ItemsControl x:Name="AddressList" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,6" HorizontalAlignment="Left">
                        <TextBlock>
                          <Run Text="{Binding AddressText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Blue}"/>
                          <Run Text="{Binding AdapterName, Mode=OneWay, StringFormat='    this PC on {0}'}" Foreground="{StaticResource Grey}"/>
                        </TextBlock>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoAddressText" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="This PC isn't on a network yet. Connect it to the same Wi-Fi or router as the TV, or use a cable (B below)."/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grey}" Margin="0,4,0,0"
                           Text="Use the dots as shown (the TV's on-screen keyboard has a . key). Then press OK."/>
              </StackPanel>

              <Border Grid.Row="3" Width="24" Height="24" CornerRadius="12" Background="{StaticResource Blue}" VerticalAlignment="Top">
                <TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,2,0,14">
                <TextBlock Text="Restart the TV" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grey}"
                           Text="Hold down the power button on the remote until the TV goes off and the Samsung logo comes up (about 5 seconds). A normal off and on doesn't count – the TV only switches Developer Mode on after a full restart."/>
              </StackPanel>

              <Border Grid.Row="4" Width="24" Height="24" CornerRadius="12" Background="{StaticResource Green}" VerticalAlignment="Top">
                <TextBlock Text="✓" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,2,0,0">
                <TextBlock Text="That's it – now go to C below and click Find my TV" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grey}"
                           Text="The TV must be on the same Wi-Fi or router as this PC. If you go back to the Apps screen you'll see Developer Mode written at the top – that means it worked."/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Step B: optional direct cable -->
        <Expander Margin="0,12,0,0" x:Name="CableExpander">
          <Expander.Header>
            <TextBlock Text="B.  Optional: TV not on a network? Use a cable from this PC" FontSize="15" FontWeight="SemiBold"/>
          </Expander.Header>
          <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="20,16">
            <StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Ink}"
                         Text="Plug an Ethernet cable from this PC into the TV. ScreenWave gives this PC's Ethernet port a fixed address the TV can talk to – no router or internet involved. Windows asks for permission once."/>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ComboBox x:Name="AdapterBox" Width="240" VerticalContentAlignment="Center" Height="34"/>
                <Button x:Name="CableButton" Content="Set up this PC for a cable" Style="{StaticResource PrimaryButton}" Click="OnCableSetup" Margin="10,0,0,0"/>
                <Button x:Name="CableUndoButton" Content="Undo" Style="{StaticResource GhostButton}" Click="OnCableUndo"
                        ToolTip="Puts this PC's Ethernet back to automatic"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="21">
                <Run Text="Then on the TV: Settings › General › Network › Network Settings › Wired. Open Network Status › IP Settings and set IP setting to Enter manually:" /><LineBreak/>
                <Run Text="     IP address 192.168.50.2   ·   Subnet mask 255.255.255.0   ·   Gateway 192.168.50.1   ·   DNS 192.168.50.1" FontWeight="SemiBold"/><LineBreak/>
                <Run Text="In Developer Mode, use 192.168.50.1 as the Host PC IP, and 192.168.50.2 as the TV's address below. When you've finished, click Undo to put this PC back to normal."/>
              </TextBlock>
            </StackPanel>
          </Border>
        </Expander>

        <!-- Step C: connect -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,16">
          <StackPanel>
            <TextBlock Text="C.  Connect" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grey}" Margin="0,4,0,0"
                       Text="Click Find my TV, or type the TV's address (on the TV: Settings › General › Network › Network Status › IP Settings)."/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,0" Width="200" Background="White">
                <TextBox x:Name="IpBox" BorderThickness="0" VerticalContentAlignment="Center" Height="34" FontSize="14" KeyDown="OnIpKey"/>
              </Border>
              <Button x:Name="FindButton" Content="Find my TV" Style="{StaticResource GhostButton}" Click="OnFind"/>
              <Button x:Name="ConnectButton" Content="Connect" Style="{StaticResource PrimaryButton}" Click="OnConnect"/>
              <Button x:Name="DisconnectButton" Content="Disconnect" Style="{StaticResource GhostButton}" Click="OnDisconnect" Visibility="Collapsed"/>
            </StackPanel>
            <ItemsControl x:Name="FoundList" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding}" Style="{StaticResource GhostButton}" Click="OnPickFound" Margin="0,0,8,0" Padding="12,6"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
      <StackPanel>
        <TextBlock x:Name="StatusText" Text="Follow A, then C." TextWrapping="Wrap"/>
        <ProgressBar x:Name="BusyBar" Style="{StaticResource BusyBarStyle}" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
