<UserControl x:Class="ScreenWave.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,18,24,18" MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Text="About" Style="{StaticResource PageTitle}"/>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,16">
        <StackPanel>
          <TextBlock FontSize="15" FontWeight="SemiBold">
            <Run Text="ScreenWave – a "/><Run Text="Second" Foreground="{StaticResource Blue}"/><Run Text="Wave" Foreground="{StaticResource Green}"/><Run Text=" IT Systems product"/>
          </TextBlock>
          <TextBlock x:Name="VersionLine" Foreground="{StaticResource Grey}" Margin="0,4,0,0"/>
          <TextBlock Foreground="{StaticResource Grey}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="Free to use. © SecondWave IT Systems. All rights reserved. Not made by or connected with Samsung."/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,16">
        <StackPanel>
          <TextBlock Text="Your privacy" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21">
            <Run Text="•  ScreenWave never connects to the internet. It only connects to private local addresses (192.168.x.x, 10.x.x.x, 172.16–31.x.x) and refuses anything else."/><LineBreak/>
            <Run Text="•  The installer adds Windows Firewall rules so ScreenWave and Samsung's sdb are blocked from every internet address – even if something tried, it couldn't get out."/><LineBreak/>
            <Run Text="•  Nothing about you, your TV, your apps or your network is sent to SecondWave IT Systems, GitHub or anyone else. No update check, no tracking."/><LineBreak/>
            <Run Text="•  The only connections it makes: to your TV (Developer Mode on port 26101, the remote on 8001/8002), to your own AdGuard Home or Pi-hole if you set one up, and Find my TV briefly checking your own network for port 26101."/><LineBreak/>
            <Run Text="•  Its log, recordings, settings and list of removed apps stay on this PC. Saved passwords are encrypted for your Windows account."/><LineBreak/>
            <Run Text="•  When you close it, it stops sdb's helper so nothing is left running."/>
          </TextBlock>
          <TextBlock x:Name="FirewallText" Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Margin="-8,12,0,0">
            <Button Content="Open ScreenWave's files" Style="{StaticResource GhostButton}" Click="OnOpenData"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,16">
        <StackPanel>
          <TextBlock Text="Third-party software" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource Grey}"
                     Text="ScreenWave includes sdb (Smart Development Bridge) from the Tizen SDK, unmodified, to talk to the TV's Developer Mode. sdb is © Samsung Electronics and the Android Open Source Project, licensed under the Apache License 2.0 (its licence is in the sdb folder where ScreenWave is installed). Samsung, Tizen and Smart Hub are trademarks of Samsung Electronics."/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
